# Copiez ce fichier en .env et renseignez vos propres valeurs.
# Ne commitez jamais le fichier .env réel (déjà ignoré par .gitignore).

# Mot de passe du panneau d'admin (/admin). Reste côté serveur uniquement,
# vérifié par une Server Action — ne JAMAIS préfixer par NEXT_PUBLIC_.
ADMIN_PASSWORD=change-me

# Personal Access Token GitHub (scope "public_repo" suffit), utilisé côté
# serveur pour synchroniser vos dépôts publics vers les planètes du site.
# Reste côté serveur uniquement — ne JAMAIS préfixer par NEXT_PUBLIC_.
GITHUB_TOKEN=

# Access key publique Web3Forms (https://web3forms.com) pour le formulaire de
# contact. Conçue pour être utilisée côté client : ce n'est pas un secret.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Base de données locale (SQLite via Prisma).
DATABASE_URL="file:./SQL.db"
